{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "OpenPawz",
  "description": "Your AI, your rules. The open-source AI agent OS with community integrations via MCP bridge, 12 channels, multi-agent orchestration — all running locally on your desktop.",
